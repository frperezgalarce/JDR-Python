    "# Directory containing .dat files\n",
    "data_dir = \"../data\"\n",
    "\n",
    "# Find RR Lyrae .dat files. Increase n_files if needed.\n",
    "n_files = 500\n",
    "min_period=0.1\n",
    "max_period=2\n",
    "precomputed_distance = False\n",
    "\n",
    "files = sorted(glob.glob(os.path.join(data_dir, \"*RRLYR*.dat\")))[:n_files]\n",
    "\n",
    "print(f\"Found {len(files)} files\")\n"
   ]
